* text=auto

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf

*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf

*.dll binary
*.exe binary
*.lib binary
*.png binary

# Overture is imported as an evidence-preserving source/resource snapshot.
# Keep its inherited whitespace intact; Framework-owned code, scripts and docs
# remain under Git's default whitespace diagnostics.
products/overture/PenumbraOverture/** whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
products/overture/HPL1Engine/** whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
products/overture/OALWrapper/** whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
products/overture/dependencies/** whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
products/overture/data/** whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
