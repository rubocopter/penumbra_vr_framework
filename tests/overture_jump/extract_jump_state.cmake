# Compile the actual production Jump class with a small native-body boundary.
# Extraction avoids compiling unrelated game states or maintaining a copied
# jump implementation in the test. Regenerate whenever the source changes.
file(READ "${SOURCE}" source)
string(FIND "${source}" "class cPlayerMoveState_Jump :" begin)
string(FIND "${source}" "class cPlayerMoveState_Crouch :" end)
if(begin LESS 0 OR end LESS begin)
    message(FATAL_ERROR "Cannot locate the production Jump class")
endif()
math(EXPR length "${end} - ${begin}")
string(SUBSTRING "${source}" ${begin} ${length} jump_class)
file(WRITE "${OUTPUT}" "${jump_class}")
file(READ "${PLAYER_SOURCE}" player_source)
# Exercise the real edge/reset and held-counter methods with the Jump class.
# Keep these definitions in the existing generated header/output dependency.
foreach(method IN ITEMS Jump SetJumpButtonDown)
    string(FIND "${player_source}" "void cPlayer::${method}(" method_begin)
    if(method_begin LESS 0)
        message(FATAL_ERROR "Cannot locate production cPlayer::${method}")
    endif()
    string(SUBSTRING "${player_source}" ${method_begin} -1 method_tail)
    string(FIND "${method_tail}" "\n}\n" method_end)
    if(method_end LESS 0)
        message(FATAL_ERROR "Cannot locate end of production cPlayer::${method}")
    endif()
    math(EXPR method_length "${method_end} + 3")
    string(SUBSTRING "${method_tail}" 0 ${method_length} method_source)
    file(APPEND "${OUTPUT}" "\n${method_source}\n")
endforeach()
string(FIND "${player_source}" "\tmpCharBody->SetMaxGravitySpeed(" gravity_begin)
string(FIND "${player_source}" "\tmpCharBody->SetMaxPushMass(" gravity_end)
if(gravity_begin LESS 0 OR gravity_end LESS gravity_begin)
    message(FATAL_ERROR "Cannot locate the production character gravity initialization")
endif()
math(EXPR gravity_length "${gravity_end} - ${gravity_begin}")
string(SUBSTRING "${player_source}" ${gravity_begin} ${gravity_length} gravity_init)
file(WRITE "${GRAVITY_OUTPUT}" "${gravity_init}")
