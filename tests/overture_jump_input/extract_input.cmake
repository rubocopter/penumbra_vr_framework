function(slice source start_marker end_marker output)
    string(FIND "${source}" "${start_marker}" begin)
    string(FIND "${source}" "${end_marker}" end)
    if(begin LESS 0 OR end LESS begin)
        message(FATAL_ERROR "Cannot extract production input boundary: ${start_marker}")
    endif()
    math(EXPR length "${end} - ${begin}")
    string(SUBSTRING "${source}" ${begin} ${length} result)
    set(${output} "${result}" PARENT_SCOPE)
endfunction()
file(READ "${ROOT}/products/overture/HPL1Engine/include/input/SteamVRInput.h" types)
slice("${types}" "  struct cVRButtonState {" "  class cSteamVRInput {" types)
file(READ "${ROOT}/src/adapters/overture_source/overture_source_integration.cpp" adapter)
slice("${adapter}" "[[nodiscard]] VrButtonState ToRuntimeButton(" "[[nodiscard]] runtime::VrTurnMode ToRuntimeTurnMode(" conversion)
file(READ "${ROOT}/products/overture/PenumbraOverture/Player.cpp" player)
slice("${player}" "void cPlayer::SetJumpButtonDown(bool abX)" "void cPlayer::StartRun()" setter)
# The separator comments between these functions are harmless C++.
file(READ "${ROOT}/products/overture/PenumbraOverture/ButtonHandler.cpp" button)
slice("${button}" "  const cVRInputState& vrInput =" "  if(vrInput.recenter.justPressed)" publish)
set(legacy "")
string(FIND "${button}" "if(mpInput->BecameTriggerd(\"Jump\"))" legacy_start)
if(NOT legacy_start LESS 0)
    slice("${button}" "if(mpInput->BecameTriggerd(\"Jump\"))" "if(mpInput->BecameTriggerd(\"Run\"))" legacy)
endif()
set(cancel_marker "if(mpInput->IsTriggerd(\"Jump\")==false || bPlayerStateIsActive==false)")
string(FIND "${button}" "${cancel_marker}" cancel_start)
if(cancel_start LESS 0)
    set(cancel_marker "if(bPlayerStateIsActive==false)")
    string(FIND "${button}" "${cancel_marker}" cancel_start)
endif()
if(cancel_start LESS 0)
    message(FATAL_ERROR "Cannot locate native inactive-state Jump cancellation")
endif()
string(SUBSTRING "${button}" ${cancel_start} -1 cancel)
string(FIND "${cancel}" "}" cancel_end)
math(EXPR cancel_length "${cancel_end} + 1")
string(SUBSTRING "${cancel}" 0 ${cancel_length} cancel)
file(WRITE "${OUTPUT}" "#ifdef PVR_INPUT_TYPES\n${types}\n#else\n${conversion}\n${setter}\nvoid cButtonHandler::UpdateRelevantJumpInput(float afTimeStep, bool vrUIContext, bool bPlayerStateIsActive) {\n${publish}\n${legacy}\n${cancel}\n}\n#endif\n")
