<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <RuntimeFrameworkVersion>9.0.19</RuntimeFrameworkVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>None</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PenumbraVrPayloadPath)" LogicalName="payload.zip" />
    <EmbeddedResource Include="$(PenumbraVrBannerPath)" LogicalName="banner.png" />
  </ItemGroup>
  <Target Name="RequirePayload" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(PenumbraVrPayloadPath)')" Text="Provide PenumbraVrPayloadPath pointing to the verified Framework package ZIP." />
    <Error Condition="!Exists('$(PenumbraVrBannerPath)')" Text="Provide PenumbraVrBannerPath pointing to the project banner." />
  </Target>
</Project>
