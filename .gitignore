# The Overture source host vendors only the Win32 link/runtime inputs needed
# for a clean product build. These exceptions are intentional source inputs.
!/products/overture/dependencies/**/*.dll
!/products/overture/dependencies/**/*.lib

# Reverse-engineering databases (export notes/signatures as text or JSON instead)
*.bak
*.bndb
*.ghidra
*.id0
*.id1
*.id2
*.i64
*.nam
*.til

